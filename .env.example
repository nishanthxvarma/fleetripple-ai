# ==============================================================================
# FleetRipple AI - Environment Configuration Example
# Copy this file to .env for local development or set in Vercel / Render dashboards.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel / Vite)
# ------------------------------------------------------------------------------
# For Local Development (proxied via Vite):
VITE_API_BASE_URL=/api

# For Production (Point to your deployed Render backend URL):
# VITE_API_BASE_URL=https://fleetripple-ai-backend.onrender.com/api

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Render / FastAPI)
# ------------------------------------------------------------------------------
# API route prefix (default: /api)
API_PREFIX=/api

# Server Port (Render sets this dynamically via $PORT)
PORT=8000
HOST=0.0.0.0

# Database Connection:
# Default SQLite (stored locally, auto-migrated & auto-seeded):
DATABASE_URL=sqlite:///./fleetripple.db
# Or Hosted PostgreSQL (e.g. Render Postgres, Neon, Supabase):
# DATABASE_URL=postgresql://user:password@hostname:5432/fleetripple_db

# CORS Allowed Origins (comma-separated or JSON list):
# Wildcard https://*.vercel.app is already permitted by default in main.py
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.vercel.app
